@prefix : <https://example.org/orda#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix loc: <https://w3id.org/dpv/loc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix orda: <https://example.org/orda#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix legal-eu: <https://w3id.org/dpv/legal/eu#> .
@base <https://example.org/orda#> .

<https://example.org/orda> rdf:type owl:Ontology ;
                            owl:versionIRI <https://example.org/orda/1.0.0> ;
                            owl:imports <https://w3id.org/dpv/2.3/owl#> ,
                                        <https://w3id.org/dpv/2.3/risk/owl#> ;
                            dct:license <https://creativecommons.org/licenses/by/4.0/> ;
                            dct:title "Research Access Ontology"@en ;
                            vann:preferredNamespacePrefix "orda" ;
                            vann:preferredNamespaceUri "https://example.org/orda#" ;
                            rdfs:comment "An ontology modelling DSA Article 40 vetted researcher access to platform data for systemic risk research. Distinguishes the Art. 40(4) DSC-mediated non-public data process from the Art. 40(12) direct public data process. Platform data is typed with W3C ActivityStreams 2.0 (as:), extended with ORDA-native terms for the categories ActivityStreams does not cover: search history, and the relation between a real-world identity and the platform accounts it holds."@en ;
                            rdfs:label "Research Access Ontology"@en ;
                            owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty ;
                rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty ;
              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/cerif/frapo/isEmployedBy
frapo:isEmployedBy rdf:type owl:ObjectProperty ;
                   rdfs:domain foaf:Agent ;
                   rdfs:range foaf:Agent ;
                   rdfs:isDefinedBy frapo: ;
                   rdfs:label "is employed by"@en .


###  http://purl.org/cerif/frapo/isFundedBy
###  http://purl.org/cerif/frapo/hasFundingAgency
frapo:hasFundingAgency rdf:type owl:ObjectProperty ;
                       rdfs:domain frapo:Funding ;
                       rdfs:range frapo:FundingAgency ;
                       rdfs:comment "Links funding to the agency providing it. Every frapo:Funding instance in ORDA is required to carry one."@en ;
                       rdfs:isDefinedBy frapo: ;
                       rdfs:label "has funding agency"@en .

###  http://purl.org/cerif/frapo/isFundedBy
frapo:isFundedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain orda:ResearchProject ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( frapo:Funding
                                            frapo:FundingAgency
                                          )
                            ] ;
                 rdfs:comment "Links a research project to the funding that finances it. FRAPO defines this property as polymorphic over both the funding and the agency providing it, so the range permits either, but ORDA requires a research project to name its frapo:Funding; the funding agency is reached from there via frapo:hasFundingAgency."@en ;
                 rdfs:isDefinedBy frapo: ;
                 rdfs:label "is funded by"@en .


###  http://purl.org/dc/terms/format
dct:format rdf:type owl:ObjectProperty ;
           rdfs:domain dcat:Distribution ;
           rdfs:range dct:MediaTypeOrExtent ;
           rdfs:isDefinedBy dct: ;
           rdfs:label "format"@en .


###  http://purl.org/dc/terms/hasFormat
dct:hasFormat rdf:type owl:ObjectProperty ;
              rdfs:domain dcat:Distribution ;
              rdfs:comment "Used here to link a dcat:Distribution to its format-specific schema description (csvw:Schema for CSV, or a foaf:Document URL for JSON Schema)."@en ;
              rdfs:isDefinedBy dct: ;
              rdfs:label "has format"@en .


###  https://www.w3.org/ns/activitystreams#actor
as:actor rdf:type owl:ObjectProperty ;
         rdfs:domain as:Activity ;
         rdfs:comment "Links an activity to the account that performed it. ActivityStreams leaves the range open (Object or Link); ORDA does not narrow it."@en ;
         rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
         rdfs:label "actor"@en .


###  https://www.w3.org/ns/activitystreams#attributedTo
as:attributedTo rdf:type owl:ObjectProperty ;
                rdfs:comment "Links an object to the account responsible for it. Used in ORDA where authorship of a post or item is asserted without a corresponding as:Create activity."@en ;
                rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
                rdfs:label "attributed to"@en .


###  https://www.w3.org/ns/activitystreams#items
as:items rdf:type owl:ObjectProperty ;
         rdfs:domain as:Collection ;
         rdfs:comment "Links a collection to its members. This is the property the orda:ActivityHistory subclasses are defined over. Note that ActivityStreams defines no 'orderedItems' property; ordering in an as:OrderedCollection is a JSON-LD serialisation concern, so as:items is used for both ordered and unordered histories."@en ;
         rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
         rdfs:label "items"@en .


###  http://www.w3.org/ns/csvw#column
csvw:column rdf:type owl:ObjectProperty ;
            rdfs:domain csvw:Schema ;
            rdfs:range csvw:Column ;
            rdfs:comment "Links a csvw:Schema to a csvw:Column description specifying the name, datatype and constraints of one column in the CSV file."@en ;
            rdfs:isDefinedBy csvw: ;
            rdfs:label "column"@en .


###  https://example.org/orda#affiliatedWith
orda:affiliatedWith rdf:type owl:ObjectProperty ;
                    owl:inverseOf orda:hasAffiliatedResearcher ;
                    rdfs:domain orda:VettedResearcher ;
                    rdfs:range [ rdf:type owl:Class ;
                                 owl:unionOf ( frapo:College
                                               frapo:ResearchInstitute
                                               frapo:University
                                             )
                               ] ;
                    rdfs:comment "Links a vetted researcher to the research organisation they are affiliated with. Art. 40(8)(a) DSA requires affiliation with a research organisation within the meaning of Dir. (EU) 2019/790 Art. 2(1); FRAPO has no single class for this, so the range is the union of its university, college and research-institute classes."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "affiliated with"@en .


###  https://example.org/orda#amendmentOutcome
orda:amendmentOutcome rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain orda:AmendmentRequest ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:oneOf ( orda:StatusAmendmentAccepted
                                               orda:StatusAmendmentRejected
                                             )
                                 ] ;
                      rdfs:comment "The outcome of an amendment request submitted under Art. 40(5) DSA."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "amendment outcome"@en .


###  https://example.org/orda#amendsRequest
orda:amendsRequest rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ,
                            owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain orda:AmendmentRequest ;
                   rdfs:range orda:ReasonedRequest ;
                   rdfs:comment "Links an amendment request to the reasoned request it seeks to modify under Art. 40(5) DSA."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "amends request"@en .


###  https://example.org/orda#appliesMeasure
orda:appliesMeasure rdf:type owl:ObjectProperty ;
                    rdfs:domain orda:AccessModality ;
                    rdfs:range orda:DataHandlingMeasure ;
                    rdfs:comment "Links an access modality to the technical, legal or organisational measures that constitute it, e.g. a technical modality applying pseudonymisation, or a legal modality applying standard contractual clauses."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "applies measure"@en .


###  https://example.org/orda#assessedBy
orda:assessedBy rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain orda:Art40_4_DataAccessRequest ;
                rdfs:range orda:DSCofEstablishment ;
                rdfs:comment "Links an Art. 40(4) data access application to the DSC of establishment that makes the final vetting decision and formulates the reasoned request."@en ;
                rdfs:isDefinedBy <https://example.org/orda> ;
                rdfs:label "assessed by"@en .


###  https://example.org/orda#assessesMitigation
orda:assessesMitigation rdf:type owl:ObjectProperty ;
                        rdfs:domain orda:ResearchProject ;
                        rdfs:range orda:DataProvider ;
                        rdfs:comment "Links a research project to the VLOP or VLOSE whose risk mitigation measures (under Art. 35 DSA) it assesses for adequacy, efficiency and impact. Shares domain with orda:investigates per Art. 40(4)."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "assesses mitigation"@en .


###  https://example.org/orda#assessesMitigationMeasure
orda:assessesMitigationMeasure rdf:type owl:ObjectProperty ;
                               rdfs:domain orda:ResearchProject ;
                               rdfs:range orda:RiskMitigationMeasure ;
                               rdfs:comment "Links a research project to the specific Art. 35 mitigation measure whose adequacy, efficiency and impact it assesses. Refines orda:assessesMitigation, which names only the platform."@en ;
                               rdfs:isDefinedBy <https://example.org/orda> ;
                               rdfs:label "assesses mitigation measure"@en .


###  https://example.org/orda#catalogueEntry
orda:catalogueEntry rdf:type owl:ObjectProperty ;
                    rdfs:domain orda:DSADataCatalogue ;
                    rdfs:range dcat:Distribution ;
                    rdfs:comment "Links a DSA data catalogue to a data asset it describes, per DA Art. 6(4). This is the property a researcher follows from a catalogue to the distributions they can then request via orda:requestsData."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "catalogue entry"@en .


###  https://example.org/orda#consultationRequestedBy
orda:consultationRequestedBy rdf:type owl:ObjectProperty ;
                             rdfs:domain orda:ExpertConsultation ;
                             rdfs:range orda:DigitalServicesCoordinator ;
                             rdfs:comment "Links an expert consultation to the DSC that requested it."@en ;
                             rdfs:isDefinedBy <https://example.org/orda> ;
                             rdfs:label "consultation requested by"@en .


###  https://example.org/orda#containsHistory
orda:containsHistory rdf:type owl:ObjectProperty ;
                     rdfs:domain dcat:Distribution ;
                     rdfs:range orda:ActivityHistory ;
                     rdfs:comment "Links a dcat:Distribution to the activity history it serialises. This is what connects the request side of the ontology to the content side: a researcher follows orda:catalogueEntry to a distribution, requests it with orda:requestsData, and reads what it holds from the orda:ActivityHistory subclass reached here. Because those subclasses are defined over the ActivityStreams type of their members, the category of data a request concerns is classified rather than asserted."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "contains history"@en .


###  https://example.org/orda#dataCatalogueOf
orda:dataCatalogueOf rdf:type owl:ObjectProperty ;
                     owl:inverseOf orda:hasDataCatalogue ;
                     rdfs:domain orda:DSADataCatalogue ;
                     rdfs:range orda:DataProvider ;
                     rdfs:comment "Links a DSA data catalogue to the VLOP or VLOSE that published it."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "data catalogue of"@en .


###  https://example.org/orda#employsMethod
orda:employsMethod rdf:type owl:ObjectProperty ;
                   rdfs:domain orda:ResearchActivity ;
                   rdfs:range orda:ResearchMethod ;
                   rdfs:comment "Links a research activity to the research method it employs."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "employs method"@en .


###  https://example.org/orda#eventActor
orda:eventActor rdf:type owl:ObjectProperty ;
                rdfs:domain orda:StatusEvent ;
                rdfs:range foaf:Agent ;
                rdfs:comment "The entity (DSC, platform, researcher) that triggered this status change."@en ;
                rdfs:isDefinedBy <https://example.org/orda> ;
                rdfs:label "event actor"@en .


###  https://example.org/orda#eventStatus
orda:eventStatus rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain orda:StatusEvent ;
                 rdfs:range skos:Concept ;
                 rdfs:comment "Links a status event to the status it represents, drawn from orda:RequestStatusScheme."@en ;
                 rdfs:isDefinedBy <https://example.org/orda> ;
                 rdfs:label "event status"@en .


###  https://example.org/orda#hasAccessJustification
orda:hasAccessJustification rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <https://w3id.org/dpv/owl#hasJustification> ;
                            rdfs:domain orda:DataAccessRequest ;
                            rdfs:range orda:AccessJustification ;
                            rdfs:comment "Links a data access request to a statement in the application justifying the access sought. DSA Art. 40(8)(e) requires the application to demonstrate that the data and the time frames requested are necessary for, and proportionate to, the purposes of the research. Every data access request must carry at least one orda:NecessityStatement and at least one orda:ProportionalityStatement; a single statement addressing both limbs may be typed as both."@en ;
                            rdfs:isDefinedBy <https://example.org/orda> ;
                            rdfs:label "has access justification"@en .


###  https://example.org/orda#hasAccessModality
orda:hasAccessModality rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( orda:DataAccessRequest
                                                   orda:ReasonedRequest
                                                 )
                                   ] ;
                       rdfs:range orda:AccessModality ;
                       rdfs:comment "Links a data access request (Art. 40(4) or Art. 40(12)), or the reasoned request formulated from it, to the access modality. At application stage the modality is researcher-proposed; for Art. 40(4) reasoned requests it is determined by the DSC of establishment per DA Art. 9."@en ;
                       rdfs:isDefinedBy <https://example.org/orda> ;
                       rdfs:label "has access modality"@en .


###  https://example.org/orda#hasAccount
orda:hasAccount rdf:type owl:ObjectProperty ;
                rdfs:domain dpv:NaturalPerson ;
                rdfs:range orda:PlatformAccount ;
                rdfs:comment "Links a real-world person to a platform account they hold. ActivityStreams has no term for this: it models accounts, not the people behind them, and as:Person is an account held by a human rather than the human themselves. The domain is dpv:NaturalPerson. DPV already names the concept ('A human'), so ORDA states the relation rather than coining a class for one of its ends. ORDA needs the relation because it is what separates the two Article 40 access routes: Art. 40(12) public data concerns accounts and their public activity, whereas Art. 40(4) non-public data may permit linkage back to the person holding them, which is the source of the re-identification risk the safeguards address. Note that ORDA researchers are typed foaf:Person, not dpv:NaturalPerson, so this property does not reach them unless a researcher's own account is being described."@en ;
                rdfs:isDefinedBy <https://example.org/orda> ;
                rdfs:label "has account"@en .


###  https://example.org/orda#hasActivities
orda:hasActivities rdf:type owl:ObjectProperty ;
                   rdfs:domain orda:PlatformAccount ;
                   rdfs:range orda:ActivityHistory ;
                   rdfs:comment "Links a platform account to a history of its activities. Corresponds to the ActivityPub notion of an actor's streams, but is stated natively because the ActivityPub collection properties are not part of the ActivityStreams 2.0 Recommendation."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "has activities"@en .


###  https://example.org/orda#hasAffiliatedResearcher
orda:hasAffiliatedResearcher rdf:type owl:ObjectProperty ;
                             rdfs:domain orda:ResearchProject ;
                             rdfs:range orda:Researcher ;
                             rdfs:comment "Links a research organisation to the vetted researchers affiliated with it. The domain is entailed from the range of orda:affiliatedWith."@en ;
                             rdfs:isDefinedBy <https://example.org/orda> ;
                             rdfs:label "has affiliated researcher"@en .


###  https://example.org/orda#hasDataAccessRequest
orda:hasDataAccessRequest rdf:type owl:ObjectProperty ;
                          owl:inverseOf orda:isPartOf ;
                          rdfs:domain orda:ResearchProject ;
                          rdfs:range orda:DataAccessRequest ;
                          rdfs:comment "Links a research project to the data access requests submitted in support of it."@en ;
                          rdfs:isDefinedBy <https://example.org/orda> ;
                          rdfs:label "has data access request"@en .


###  https://example.org/orda#hasDataCatalogue
orda:hasDataCatalogue rdf:type owl:ObjectProperty ;
                      rdfs:domain orda:DataProvider ;
                      rdfs:range orda:DSADataCatalogue ;
                      rdfs:comment "Links a VLOP or VLOSE to its published DSA data catalogue per DA Art. 6(4)."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "has data catalogue"@en .


###  https://example.org/orda#hasDataManagementPlan
orda:hasDataManagementPlan rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain orda:ResearchProject ;
                           rdfs:range orda:DataManagementPlan ;
                           rdfs:comment "Links a research project to the data management plan that governs how accessed data will be stored, processed and protected."@en ;
                           rdfs:isDefinedBy <https://example.org/orda> ;
                           rdfs:label "has data management plan"@en .


###  https://example.org/orda#hasExpertConsultation
orda:hasExpertConsultation rdf:type owl:ObjectProperty ;
                           rdfs:domain orda:Art40_4_DataAccessRequest ;
                           rdfs:range orda:ExpertConsultation ;
                           rdfs:comment "Links an Art. 40(4) application to an expert consultation conducted during its assessment per DA Art. 14."@en ;
                           rdfs:isDefinedBy <https://example.org/orda> ;
                           rdfs:label "has expert consultation"@en .


###  https://example.org/orda#hasMeasure
orda:hasMeasure rdf:type owl:ObjectProperty ;
                rdfs:domain dcat:Distribution ;
                rdfs:range orda:DataHandlingMeasure ;
                rdfs:comment "Links a dcat:Distribution to a technical, legal or organisational measure governing how the data it describes may be accessed and handled."@en ;
                rdfs:isDefinedBy <https://example.org/orda> ;
                rdfs:label "has measure"@en .


###  https://example.org/orda#hasMethod
orda:hasMethod rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( orda:ResearchActivity
                                           orda:ResearchProject
                                         )
                           ] ;
               rdfs:range orda:ResearchMethod ;
               rdfs:comment "Links a research project to the research methods it employs."@en ;
               rdfs:isDefinedBy <https://example.org/orda> ;
               rdfs:label "has method"@en .


###  https://example.org/orda#hasMitigationMeasure
orda:hasMitigationMeasure rdf:type owl:ObjectProperty ;
                          rdfs:domain orda:DataProvider ;
                          rdfs:range orda:RiskMitigationMeasure ;
                          rdfs:comment "Links a VLOP or VLOSE to a risk mitigation measure it has put in place under DSA Art. 35."@en ;
                          rdfs:isDefinedBy <https://example.org/orda> ;
                          rdfs:label "has mitigation measure"@en .


###  https://example.org/orda#hasParticipant
orda:hasParticipant rdf:type owl:ObjectProperty ;
                    owl:inverseOf orda:participatesIn ;
                    rdfs:domain orda:ResearchProject ;
                    rdfs:range orda:Researcher ;
                    rdfs:comment "Links a research project to the researchers participating in it. A project may have many."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "has participant"@en .


###  https://example.org/orda#hasResearchActivity
orda:hasResearchActivity rdf:type owl:ObjectProperty ;
                         rdfs:domain orda:ResearchProject ;
                         rdfs:range orda:ResearchActivity ;
                         rdfs:comment "Links a research project to the research activities it comprises."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "has research activity"@en .


###  https://example.org/orda#hasResearchQuestion
orda:hasResearchQuestion rdf:type owl:ObjectProperty ;
                         rdfs:domain orda:ResearchProject ;
                         rdfs:range orda:ResearchQuestion ;
                         rdfs:comment "Links a research project to the research questions it addresses."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "has research question"@en .


###  https://example.org/orda#hasReview
orda:hasReview rdf:type owl:ObjectProperty ;
               rdfs:domain orda:ResearchMethod ;
               rdfs:range orda:ExpertConsultation ;
               rdfs:comment "Links a research method to the expert consultation (e.g. orda:MethodologicalReview) that reviews it for necessity and proportionality."@en ;
               rdfs:isDefinedBy <https://example.org/orda> ;
               rdfs:label "has review"@en .


###  https://example.org/orda#hasStatusEvent
orda:hasStatusEvent rdf:type owl:ObjectProperty ;
                    rdfs:domain orda:DataAccessRequest ;
                    rdfs:range orda:StatusEvent ;
                    rdfs:comment "Links a data access request to a timestamped status change event in its lifecycle."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "has status event"@en .


###  https://example.org/orda#hasTopic
orda:hasTopic rdf:type owl:ObjectProperty ;
              rdfs:domain orda:ResearchProject ;
              rdfs:range orda:ResearchTopic ;
              rdfs:comment "Links a research project to the research topics it covers."@en ;
              rdfs:isDefinedBy <https://example.org/orda> ;
              rdfs:label "has topic"@en .


###  https://example.org/orda#includesResearcher
orda:includesResearcher rdf:type owl:ObjectProperty ;
                        rdfs:domain orda:DataAccessRequest ;
                        rdfs:range orda:ApplicantResearcher ;
                        rdfs:comment "Links a data access request to every researcher covered by it, including the principal researcher (orda:madeBy is a sub-property of this). Per DA Art. 10, the reasoned request must identify all researchers."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "includes researcher"@en .


###  https://example.org/orda#initiallyAssessedBy
orda:initiallyAssessedBy rdf:type owl:ObjectProperty ;
                         rdfs:domain orda:Art40_4_DataAccessRequest ;
                         rdfs:range orda:DSCofMemberState ;
                         rdfs:comment "Links an Art. 40(4) application (submitted via the researcher's own member state under Art. 40(9)) to the DSC that conducted the initial assessment before forwarding to the DSC of establishment."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "initially assessed by"@en .


###  https://example.org/orda#investigates
orda:investigates rdf:type owl:ObjectProperty ;
                  rdfs:domain orda:ResearchProject ;
                  rdfs:range orda:SystemicRisk ;
                  rdfs:comment "Links a research project to the DSA systemic risk category it investigates under Art. 34(1). Distinct from dpv:hasRisk which covers data processing risks."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "investigates"@en .


###  https://example.org/orda#isPartOf
orda:isPartOf rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain orda:DataAccessRequest ;
              rdfs:range orda:ResearchProject ;
              rdfs:comment "Links a data access request to the research project it supports."@en ;
              rdfs:isDefinedBy <https://example.org/orda> ;
              rdfs:label "is part of"@en .


###  https://example.org/orda#isTargetOf
orda:isTargetOf rdf:type owl:ObjectProperty ;
                owl:inverseOf orda:targets ;
                rdfs:domain orda:DataProvider ;
                rdfs:range orda:DataAccessRequest ;
                rdfs:comment "Links a VLOP or VLOSE to the data access requests directed at it."@en ;
                rdfs:isDefinedBy <https://example.org/orda> ;
                rdfs:label "is target of"@en .


###  https://example.org/orda#issuedBy
orda:issuedBy rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain orda:ReasonedRequest ;
              rdfs:range orda:DSCofEstablishment ;
              rdfs:comment "Links a reasoned request to the DSC of establishment that formulated it."@en ;
              rdfs:isDefinedBy <https://example.org/orda> ;
              rdfs:label "issued by"@en .


###  https://example.org/orda#issuedTo
orda:issuedTo rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain orda:ReasonedRequest ;
              rdfs:range orda:DataProvider ;
              rdfs:comment "Links a reasoned request to the VLOP or VLOSE to which it is addressed."@en ;
              rdfs:isDefinedBy <https://example.org/orda> ;
              rdfs:label "issued to"@en .


###  https://example.org/orda#madeBy
orda:madeBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf orda:includesResearcher ;
            owl:inverseOf orda:submittedRequest ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain orda:DataAccessRequest ;
            rdfs:range orda:PrincipalResearcher ;
            rdfs:comment "Links a data access request to the principal researcher who submitted it. Per DA Art. 2 and 7, the principal researcher is the primary contact and bears responsibility for the application."@en ;
            rdfs:isDefinedBy <https://example.org/orda> ;
            rdfs:label "made by"@en .


###  https://example.org/orda#participatesIn
orda:participatesIn rdf:type owl:ObjectProperty ;
                    rdfs:domain orda:Researcher ;
                    rdfs:range orda:ResearchProject ;
                    rdfs:comment "Links a researcher to a research project they participate in."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "participates in"@en .


###  https://example.org/orda#publishedIn
orda:publishedIn rdf:type owl:ObjectProperty ;
                 rdfs:domain orda:ReasonedRequest ;
                 rdfs:range orda:DSADataAccessPortal ;
                 rdfs:comment "Links a reasoned request to the DSA Data Access Portal where its overview is published per DA Art. 11."@en ;
                 rdfs:isDefinedBy <https://example.org/orda> ;
                 rdfs:label "published in"@en .


###  https://example.org/orda#questionInvestigates
orda:questionInvestigates rdf:type owl:ObjectProperty ;
                          rdfs:domain orda:ResearchQuestion ;
                          rdfs:range orda:SystemicRisk ;
                          rdfs:comment "Links a research question to the DSA systemic risk it investigates. Distinct from orda:investigates whose domain is orda:ResearchProject. Research topics are attached at project level via orda:hasTopic."@en ;
                          rdfs:isDefinedBy <https://example.org/orda> ;
                          rdfs:label "question investigates"@en .


###  https://example.org/orda#referencesDataCatalogue
orda:referencesDataCatalogue rdf:type owl:ObjectProperty ;
                             rdfs:domain orda:DataAccessRequest ;
                             rdfs:range orda:DSADataCatalogue ;
                             rdfs:comment "Links a data access request to the platform data catalogue it references."@en ;
                             rdfs:isDefinedBy <https://example.org/orda> ;
                             rdfs:label "references data catalogue"@en .


###  https://example.org/orda#requestStatus
orda:requestStatus rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain orda:DataAccessRequest ;
                   rdfs:range [ rdf:type owl:Class ;
                                owl:oneOf ( orda:StatusAmendmentAccepted
                                            orda:StatusAmendmentRejected
                                            orda:StatusAmendmentRequested
                                            orda:StatusDataProvided
                                            orda:StatusInMediation
                                            orda:StatusReasonedRequestFormulated
                                            orda:StatusRejected
                                            orda:StatusSubmitted
                                            orda:StatusTerminated
                                            orda:StatusUnderAssessment
                                          )
                              ] ;
                   rdfs:comment "The current status of the request, drawn from orda:RequestStatusScheme. For full history, see orda:hasStatusEvent."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "request status"@en .


###  https://example.org/orda#requestedBy
orda:requestedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain orda:AmendmentRequest ;
                 rdfs:range orda:DataProvider ;
                 rdfs:comment "Links an amendment request to the VLOP or VLOSE that submitted it under Art. 40(5) DSA."@en ;
                 rdfs:isDefinedBy <https://example.org/orda> ;
                 rdfs:label "requested by"@en .


###  https://example.org/orda#requestedFrom
orda:requestedFrom rdf:type owl:ObjectProperty ;
                   rdfs:domain orda:Art40_12_DataAccessRequest ;
                   rdfs:range orda:DataProvider ;
                   rdfs:comment "Links an Art. 40(12) public data request directly to the platform, without DSC intermediation."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "requested from"@en .


###  https://example.org/orda#requestsData
orda:requestsData rdf:type owl:ObjectProperty ;
                  rdfs:domain orda:DataAccessRequest ;
                  rdfs:range dcat:Distribution ;
                  rdfs:comment "Links a data access request to the dcat:Distribution it requests from the platform."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "requests data"@en .


###  https://example.org/orda#resultsFrom
orda:resultsFrom rdf:type owl:ObjectProperty ;
                 owl:inverseOf orda:resultsIn ;
                 rdfs:domain orda:ReasonedRequest ;
                 rdfs:range orda:Art40_4_DataAccessRequest ;
                 rdfs:comment "Links a reasoned request to the Art. 40(4) application it was formulated from."@en ;
                 rdfs:isDefinedBy <https://example.org/orda> ;
                 rdfs:label "results from"@en .


###  https://example.org/orda#resultsIn
orda:resultsIn rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ,
                        owl:InverseFunctionalProperty ;
               rdfs:domain orda:Art40_4_DataAccessRequest ;
               rdfs:range orda:ReasonedRequest ;
               rdfs:comment "Links an Art. 40(4) data access application to the reasoned request formulated by the DSC of establishment. The reasoned request is the operative legal instrument that triggers the platform's obligation to provide data."@en ;
               rdfs:isDefinedBy <https://example.org/orda> ;
               rdfs:label "results in"@en .


###  https://example.org/orda#riskArisesOn
orda:riskArisesOn rdf:type owl:ObjectProperty ;
                  rdfs:domain orda:SystemicRisk ;
                  rdfs:range orda:DataProvider ;
                  rdfs:comment "Links a systemic risk to the VLOP or VLOSE from whose design or functioning it stems, per DSA Art. 34(1)."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "risk arises on"@en .


###  https://example.org/orda#submittedRequest
orda:submittedRequest rdf:type owl:ObjectProperty ;
                      rdfs:domain orda:PrincipalResearcher ;
                      rdfs:range orda:DataAccessRequest ;
                      rdfs:comment "Links a principal researcher to the data access requests they submitted."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "submitted request"@en .


###  https://example.org/orda#submittedVia
orda:submittedVia rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain orda:Art40_4_DataAccessRequest ;
                  rdfs:range orda:DSADataAccessPortal ;
                  rdfs:comment "Links an Art. 40(4) data access application to the DSA Data Access Portal through which it was submitted. Per DA Art. 3, all Art. 40(4) applications must be submitted through this portal."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "submitted via"@en .


###  https://example.org/orda#suggestsModality
orda:suggestsModality rdf:type owl:ObjectProperty ;
                      rdfs:domain orda:DataAccessRequest ;
                      rdfs:range orda:AccessModality ;
                      rdfs:comment "Links a data access request to the access modality proposed by the researcher. Distinct from orda:hasAccessModality on the ReasonedRequest, which records the modality determined by the DSC of establishment per DA Art. 9."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "suggests modality"@en .


###  https://example.org/orda#targets
orda:targets rdf:type owl:ObjectProperty ;
             rdfs:domain orda:DataAccessRequest ;
             rdfs:range orda:DataProvider ;
             rdfs:comment "Links a data access request to the VLOP or VLOSE from which data is requested."@en ;
             rdfs:isDefinedBy <https://example.org/orda> ;
             rdfs:label "targets"@en .


###  https://w3id.org/dpv/owl#hasContext
<https://w3id.org/dpv/owl#hasContext> rdfs:domain orda:ResearchProject ;
                                      rdfs:range <https://w3id.org/dpv/owl#Context> .


###  https://w3id.org/dpv/owl#hasData
<https://w3id.org/dpv/owl#hasData> rdfs:domain orda:ResearchProject .


###  https://w3id.org/dpv/owl#hasDataSubject
<https://w3id.org/dpv/owl#hasDataSubject> rdfs:domain orda:DataAccessRequest ;
                                          rdfs:range dpv:DataSubject .


###  https://w3id.org/dpv/owl#hasJurisdiction
<https://w3id.org/dpv/owl#hasJurisdiction> rdfs:domain orda:SystemicRisk ;
                                           rdfs:range dpv:Location .


###  https://w3id.org/dpv/owl#hasLegalBasis
<https://w3id.org/dpv/owl#hasLegalBasis> rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( orda:DataAccessRequest
                                                                     orda:ResearchProject
                                                                   )
                                                     ] ;
                                         rdfs:range <https://w3id.org/dpv/owl#LegalBasis> .


###  https://w3id.org/dpv/owl#hasPurpose
<https://w3id.org/dpv/owl#hasPurpose> rdfs:domain orda:ResearchProject .


###  https://w3id.org/dpv/risk/owl#hasRiskAssessment
<https://w3id.org/dpv/risk/owl#hasRiskAssessment> rdfs:domain orda:Art40_4_DataAccessRequest ;
                                                  rdfs:range <https://w3id.org/dpv/owl#RiskAssessment> .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/cerif/frapo/hasEndDate
frapo:hasEndDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( frapo:Funding
                                             orda:ResearchProject
                                           )
                             ] ;
                 rdfs:range xsd:dateTime ;
                 rdfs:isDefinedBy frapo: ;
                 rdfs:label "has end date"@en .


###  http://purl.org/cerif/frapo/hasGrantNumber
frapo:hasGrantNumber rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( frapo:Grant
                                                 orda:ResearchProject
                                               )
                                 ] ;
                     rdfs:isDefinedBy frapo: ;
                     rdfs:label "has grant number"@en .


###  http://purl.org/cerif/frapo/hasStartDate
frapo:hasStartDate rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( frapo:Funding
                                               frapo:Grant
                                               orda:ResearchProject
                                             )
                               ] ;
                   rdfs:range xsd:dateTime ;
                   rdfs:isDefinedBy frapo: ;
                   rdfs:label "has start date"@en .


###  http://purl.org/dc/terms/description
dct:description rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string ;
                rdfs:comment "Free text supplied by a party to the process (an applicant, a platform or a DSC), as opposed to a value ORDA models structurally. ORDA uses this for descriptive text directly where a subject carries only one such text, as on orda:ResearchProject and on the orda:AccessJustification statements, and makes the narrower properties subproperties of it where a subject carries several, so that orda:independenceDeclaration, orda:publicationTimeline and orda:amendmentGrounds remain individually identifiable while still being reachable generically. Left without a domain deliberately, so that ORDA constrains nothing about the term for importers. Typed here as an owl:DatatypeProperty, which DCMI itself does not commit to."@en ;
                rdfs:isDefinedBy dct: ;
                rdfs:label "description"@en .


###  http://purl.org/dc/terms/identifier
dct:identifier rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain orda:DataAccessRequest ;
               rdfs:range xsd:string ;
               rdfs:comment "The reference under which a data access request is registered, e.g. in the DSA Data Access Portal."@en ;
               rdfs:isDefinedBy dct: ;
               rdfs:label "identifier"@en .


###  http://www.w3.org/ns/csvw#datatype
csvw:datatype rdf:type owl:DatatypeProperty ;
              rdfs:domain csvw:Column ;
              rdfs:range xsd:string ;
              rdfs:comment "The datatype of values in this column, e.g. 'string', 'integer', 'dateTime'. Corresponds to the built-in CSVW datatypes or an XSD type name."@en ;
              rdfs:isDefinedBy csvw: ;
              rdfs:label "datatype"@en .


###  http://www.w3.org/ns/csvw#name
csvw:name rdf:type owl:DatatypeProperty ;
          rdfs:domain csvw:Column ;
          rdfs:range xsd:string ;
          rdfs:comment "The name of the column as it appears in the CSV header row. Used as the column identifier in CSVW processing."@en ;
          rdfs:isDefinedBy csvw: ;
          rdfs:label "name"@en .


###  http://www.w3.org/ns/csvw#required
csvw:required rdf:type owl:DatatypeProperty ;
              rdfs:domain csvw:Column ;
              rdfs:range xsd:boolean ;
              rdfs:comment "If true, every row in the CSV must have a non-null value for this column."@en ;
              rdfs:isDefinedBy csvw: ;
              rdfs:label "required"@en .


###  http://www.w3.org/ns/csvw#titles
csvw:titles rdf:type owl:DatatypeProperty ;
            rdfs:domain csvw:Column ;
            rdfs:range xsd:string ;
            rdfs:comment "A human-readable title for the column, used in documentation and display. May be language-tagged."@en ;
            rdfs:isDefinedBy csvw: ;
            rdfs:label "titles"@en .


###  https://example.org/orda#accessEndDate
orda:accessEndDate rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( orda:AmendmentRequest
                                               orda:DataAccessRequest
                                               orda:ReasonedRequest
                                             )
                               ] ;
                   rdfs:range xsd:date ;
                   rdfs:comment "The date on which the period of access ends. Required on a data access request, where it is proposed by the researcher: DSA Art. 40(8)(e) requires the application to demonstrate that the data and 'the time frames requested' are necessary and proportionate, which presupposes that the application states them. Optional on a reasoned request, where per DA Art. 10 the DSC determines the period of access rather than proposing it, and on an amendment request, where a platform may propose a different period under DSA Art. 40(5)."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "access end date"@en .


###  https://example.org/orda#accessStartDate
orda:accessStartDate rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( orda:AmendmentRequest
                                                 orda:DataAccessRequest
                                                 orda:ReasonedRequest
                                               )
                                 ] ;
                     rdfs:range xsd:date ;
                     rdfs:comment "The date from which the data is to be made available. Required on a data access request, where it is proposed by the researcher: DSA Art. 40(8)(e) requires the application to demonstrate that the data and 'the time frames requested' are necessary and proportionate, which presupposes that the application states them. Optional on a reasoned request, where per DA Art. 10 the DSC determines the period of access rather than proposing it, and on an amendment request, where a platform may propose a different period under DSA Art. 40(5)."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "access start date"@en .


###  https://example.org/orda#amendmentGrounds
orda:amendmentGrounds rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf dct:description ;
                      rdfs:domain orda:AmendmentRequest ;
                      rdfs:range xsd:string ;
                      rdfs:comment "The grounds for the amendment request per Art. 40(5) DSA: (a) platform does not have access to the data, or (b) access would create significant vulnerabilities."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "amendment grounds"@en .


###  https://example.org/orda#eventDate
orda:eventDate rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain orda:StatusEvent ;
               rdfs:range xsd:date ;
               rdfs:comment "The date on which this status change occurred."@en ;
               rdfs:isDefinedBy <https://example.org/orda> ;
               rdfs:label "event date"@en .


###  https://example.org/orda#hasPublicationCommitment
orda:hasPublicationCommitment rdf:type owl:DatatypeProperty ;
                              rdfs:domain orda:Art40_4_DataAccessRequest ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Whether the researcher has committed to publishing results publicly and free of charge within a reasonable period, as required by Art. 40(8)(g) DSA."@en ;
                              rdfs:isDefinedBy <https://example.org/orda> ;
                              rdfs:label "has publication commitment"@en .


###  https://example.org/orda#independenceDeclaration
orda:independenceDeclaration rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf dct:description ;
                             rdfs:domain orda:DataAccessRequest ;
                             rdfs:range xsd:string ;
                             rdfs:comment "A declaration by the researcher that they are independent from commercial interests in relation to the specific research project, as required by Art. 40(8)(b) DSA."@en ;
                             rdfs:isDefinedBy <https://example.org/orda> ;
                             rdfs:label "independence declaration"@en .


###  https://example.org/orda#projectEndDate
orda:projectEndDate rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain orda:ResearchProject ;
                    rdfs:range xsd:date ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "project end date"@en .


###  https://example.org/orda#projectStartDate
orda:projectStartDate rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain orda:ResearchProject ;
                      rdfs:range xsd:date ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "project start date"@en .


###  https://example.org/orda#projectTitle
orda:projectTitle rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain orda:ResearchProject ;
                  rdfs:range xsd:string ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "project title"@en .


###  https://example.org/orda#publicationTimeline
orda:publicationTimeline rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf dct:description ;
                         rdfs:domain orda:Art40_4_DataAccessRequest ;
                         rdfs:range xsd:string ;
                         rdfs:comment "The planned timeline for making research results publicly available, e.g. 'within 12 months of completion'."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "publication timeline"@en .


###  https://example.org/orda#requestDate
orda:requestDate rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain orda:DataAccessRequest ;
                 rdfs:range xsd:date ;
                 rdfs:comment "The date on which the data access request was submitted."@en ;
                 rdfs:isDefinedBy <https://example.org/orda> ;
                 rdfs:label "request date"@en .


###  https://example.org/orda#researcherEmail
orda:researcherEmail rdf:type owl:DatatypeProperty ;
                     rdfs:domain orda:VettedResearcher ;
                     rdfs:range xsd:string ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "researcher email"@en .


###  https://example.org/orda#researcherName
orda:researcherName rdf:type owl:DatatypeProperty ;
                    rdfs:domain orda:VettedResearcher ;
                    rdfs:range xsd:string ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "researcher name"@en .


#################################################################
#    Classes
#################################################################

###  http://data.europa.eu/eli/ontology#LegalResource
eli:LegalResource rdf:type owl:Class ;
                  rdfs:comment "A legal resource such as a law, regulation or treaty."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/eli/ontology> ;
                  rdfs:label "Legal Resource"@en .


###  http://purl.org/cerif/frapo/College
frapo:College rdf:type owl:Class ;
              rdfs:subClassOf foaf:Organization ;
              rdfs:isDefinedBy frapo: ;
              rdfs:label "College"@en .


###  http://purl.org/cerif/frapo/Funding
frapo:Funding rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty frapo:hasFundingAgency ;
                                owl:someValuesFrom frapo:FundingAgency
                              ] ;
              rdfs:comment "An amount of money available to finance some project or activity. Within ORDA every instance must name the agency providing it, so that the funding disclosure required by Art. 40(8)(b) DSA is reachable from any funded research project."@en ;
              rdfs:isDefinedBy frapo: ;
              rdfs:label "Funding"@en .


###  http://purl.org/cerif/frapo/FundingAgency
frapo:FundingAgency rdf:type owl:Class ;
                    rdfs:subClassOf foaf:Organization ;
                    rdfs:isDefinedBy frapo: ;
                    rdfs:label "Funding Agency"@en .


###  http://purl.org/cerif/frapo/Grant
frapo:Grant rdf:type owl:Class ;
            rdfs:subClassOf frapo:Funding ;
            rdfs:isDefinedBy frapo: ;
            rdfs:label "Grant"@en .


###  http://purl.org/cerif/frapo/Project
frapo:Project rdf:type owl:Class ;
              rdfs:isDefinedBy frapo: ;
              rdfs:label "Project"@en .


###  http://purl.org/cerif/frapo/ResearchInstitute
frapo:ResearchInstitute rdf:type owl:Class ;
                        rdfs:subClassOf foaf:Organization ;
                        rdfs:isDefinedBy frapo: ;
                        rdfs:label "Research Institute"@en .


###  http://purl.org/cerif/frapo/University
frapo:University rdf:type owl:Class ;
                 rdfs:subClassOf foaf:Organization ;
                 rdfs:isDefinedBy frapo: ;
                 rdfs:label "University"@en .


###  http://purl.org/dc/terms/MediaTypeOrExtent
dct:MediaTypeOrExtent rdf:type owl:Class ;
                      rdfs:isDefinedBy dct: ;
                      rdfs:label "Media Type or Extent"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class ;
             rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class ;
                   rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .


###  http://www.w3.org/ns/csvw#Column
csvw:Column rdf:type owl:Class ;
            rdfs:comment "A description of a single column in a CSV file, specifying its name, datatype, title and constraints per the CSVW specification."@en ;
            rdfs:isDefinedBy csvw: ;
            rdfs:label "Column"@en .


###  http://www.w3.org/ns/csvw#Schema
csvw:Schema rdf:type owl:Class ;
            rdfs:comment "A schema describing the columns of a CSV file, linked to a dcat:Distribution via dct:hasFormat."@en ;
            rdfs:isDefinedBy csvw: ;
            rdfs:label "Schema"@en .


###  http://www.w3.org/ns/dcat#Distribution
dcat:Distribution rdf:type owl:Class ;
                  owl:disjointWith orda:ReasonedRequest ;
                  rdfs:isDefinedBy dcat: ;
                  rdfs:label "Distribution"@en .


###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:Class ;
           rdfs:isDefinedBy foaf: ;
           rdfs:label "Agent"@en .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class ;
                  rdfs:isDefinedBy foaf: ;
                  rdfs:label "Organization"@en .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class ;
            rdfs:isDefinedBy foaf: ;
            rdfs:label "Person"@en .


###  https://example.org/orda#AccessJustification
orda:AccessJustification rdf:type owl:Class ;
                         rdfs:subClassOf dpv:Justification ;
                         rdfs:comment "A statement made in a data access application justifying the access sought, reached via orda:hasAccessJustification. DSA Art. 40(8)(e) requires an application to demonstrate that access to the data and the time frames requested are necessary for, and proportionate to, the purposes of the research. The condition applies on both access routes: directly for Art. 40(4) applications as part of vetting under Art. 40(8), and for Art. 40(12) public data requests through that paragraph's cross-reference to Art. 40(8) points (b) to (e). The statement text is carried by dct:description. The class is a subclass of dpv:Justification and orda:hasAccessJustification a subproperty of dpv:hasJustification, so ORDA aligns with DPV without asserting anything about the DPV terms themselves."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "Access Justification"@en ;
                         rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_40> .


###  https://example.org/orda#AccessModality
orda:AccessModality rdf:type owl:Class ;
                    rdfs:comment "The technical, legal and organisational arrangement through which a VLOP or VLOSE provides data to vetted researchers, as determined by the DSC of establishment per DA Art. 9."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "Access Modality"@en .


###  https://example.org/orda#ActivityHistory
orda:ActivityHistory rdf:type owl:Class ;
                     rdfs:subClassOf as:OrderedCollection ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty as:items ;
                                       owl:allValuesFrom as:Activity
                                     ] ;
                     rdfs:comment "A collection of platform activities belonging to one account. The primary unit of data returned by a DSA Article 40 data access request. The subclasses below are defined classes over the ActivityStreams activity type of their members, so a distribution's contents can be classified from the activities it holds rather than asserted by hand. Each is defined as containing at least one, and only, members of its activity type; the 'at least one' half is deliberate, since a definition using only an owl:allValuesFrom restriction would classify every empty history as an instance of every subclass. Note that classification of a particular history requires that history to be closed (an individual must state that its asserted members are all of its members, by an owl:oneOf or cardinality axiom on as:items), because under the open-world assumption further members of other types are otherwise possible. See orda:ExampleShareHistory in the example data."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Activity History"@en .


###  https://example.org/orda#AmendmentRequest
orda:AmendmentRequest rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty orda:amendsRequest ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass orda:ReasonedRequest
                                      ] ;
                      rdfs:comment "A request by a VLOP or VLOSE to amend a reasoned request under DSA Art. 40(5), submitted within 15 days of receipt. Grounds: (a) platform does not have access to the requested data, or (b) access would create significant vulnerabilities in service security or protection of confidential information."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "Amendment Request"@en .


###  https://example.org/orda#ApplicantResearcher
orda:ApplicantResearcher rdf:type owl:Class ;
                         rdfs:subClassOf orda:Researcher ;
                         rdfs:comment "A researcher named on a data access application. Every application must name at least one. An applicant researcher may or may not also be the principal researcher, and may or may not already hold vetted researcher status; the classes deliberately overlap."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "Applicant Researcher"@en .


###  https://example.org/orda#Art40_12_DataAccessRequest
orda:Art40_12_DataAccessRequest rdf:type owl:Class ;
                                rdfs:subClassOf orda:DataAccessRequest ;
                                owl:disjointWith orda:Art40_4_DataAccessRequest ;
                                rdfs:comment "A data access request under DSA Art. 40(12) for publicly accessible platform data. Submitted directly to the platform without DSC intermediation. Researchers need not be formally vetted but must meet conditions in Art. 40(8)(b)-(e). Includes researchers affiliated with not-for-profit bodies, organisations and associations. The Delegated Regulation 2025/2050 does not govern this process."@en ;
                                rdfs:isDefinedBy <https://example.org/orda> ;
                                rdfs:label "Art. 40(12) Data Access Request"@en .


###  https://example.org/orda#Art40_4_DataAccessRequest
orda:Art40_4_DataAccessRequest rdf:type owl:Class ;
                               rdfs:subClassOf orda:DataAccessRequest ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty orda:hasPublicationCommitment ;
                                                 owl:hasValue "true"^^xsd:boolean
                                               ] ;
                               rdfs:comment "A data access application under DSA Art. 40(4) for non-public platform data. Requires: (1) submission via the DSA Data Access Portal, (2) assessment by the DSC of establishment, (3) formal vetting of the researcher under Art. 40(8), and (4) formulation of a reasoned request by the DSC to the platform. Governed by Delegated Regulation 2025/2050."@en ;
                               rdfs:isDefinedBy <https://example.org/orda> ;
                               rdfs:label "Art. 40(4) Data Access Request"@en ;
                               rdfs:seeAlso <http://data.europa.eu/eli/reg_del/2025/2050/oj> .


###  https://example.org/orda#BlockHistory
orda:BlockHistory rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:intersectionOf ( orda:ActivityHistory
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty as:items ;
                                                               owl:someValuesFrom as:Block
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty as:items ;
                                                               owl:allValuesFrom as:Block
                                                             ]
                                                           )
                                      ] ;
                  rdfs:comment "A history of accounts blocked. Defined over as:Block, which ActivityStreams places under as:Ignore rather than directly under as:Activity."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "Block History"@en .


###  https://example.org/orda#CSVDistribution
orda:CSVDistribution rdf:type owl:Class ;
                     rdfs:subClassOf dcat:Distribution ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty dct:hasFormat ;
                                       owl:someValuesFrom csvw:Schema
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty dct:format ;
                                       owl:hasValue <http://publications.europa.eu/resource/authority/file-type/CSV>
                                     ] ;
                     rdfs:comment "A dcat:Distribution in CSV format (dct:format = EU file-type/CSV) that carries a csvw:Schema via dct:hasFormat, describing column names, datatypes and constraints per the CSVW specification (https://w3c.github.io/csvw/syntax/)."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "CSV Distribution"@en ;
                     rdfs:seeAlso <https://w3c.github.io/csvw/syntax/> .


###  https://example.org/orda#CivicDiscourseRisk
orda:CivicDiscourseRisk rdf:type owl:Class ;
                        rdfs:subClassOf orda:SystemicRisk ;
                        rdfs:comment "DSA Art. 34(1)(c): systemic risks of negative effects on civic discourse, electoral processes or public security."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Civic Discourse Risk"@en .


###  https://example.org/orda#ConsumeHistory
orda:ConsumeHistory rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:intersectionOf ( orda:ActivityHistory
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty as:items ;
                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                 owl:unionOf ( as:Listen
                                                                               as:Read
                                                                               as:View
                                                                             )
                                                               ]
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty as:items ;
                                                                 owl:allValuesFrom [ rdf:type owl:Class ;
                                                                 owl:unionOf ( as:Listen
                                                                               as:Read
                                                                               as:View
                                                                             )
                                                               ]
                                                               ]
                                                             )
                                        ] ;
                    rdfs:comment "A history of content viewed, read or listened to. This is the closest ActivityStreams equivalent of a platform impression or recommender delivery log, and is typically the Art. 40(4) non-public data category most relevant to systemic risk research on recommender systems."@en ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "Consume History"@en .


###  https://example.org/orda#DSADataAccessPortal
orda:DSADataAccessPortal rdf:type owl:Class ;
                         rdfs:comment "The centralised digital infrastructure established under DA Art. 3 through which Art. 40(4) applications are submitted, reasoned request overviews are published, and the data access process is managed. Operated by the European Commission."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "DSA Data Access Portal"@en ;
                         rdfs:seeAlso <http://data.europa.eu/eli/reg_del/2025/2050/oj> .


###  https://example.org/orda#DSADataCatalogue
orda:DSADataCatalogue rdf:type owl:Class ;
                      rdfs:comment "A catalogue of available data assets published by a VLOP or VLOSE per DA Art. 6(4), describing data structure, metadata, and suggested access modalities to help researchers formulate applications."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "DSA Data Catalogue"@en .


###  https://example.org/orda#DSCofEstablishment
orda:DSCofEstablishment rdf:type owl:Class ;
                        rdfs:subClassOf orda:DigitalServicesCoordinator ;
                        rdfs:comment "The DSC of the member state where the VLOP or VLOSE is primarily established in the EU. Makes the final decision on vetting, formulates reasoned requests, and determines access modalities. Per DSA Art. 40(4) and (8). Deliberately NOT disjoint with orda:DSCofMemberState: where the researcher's institution and the platform are established in the same member state, one authority holds both roles. Do not add a disjointness axiom between them."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "DSC of Establishment"@en .


###  https://example.org/orda#DSCofMemberState
orda:DSCofMemberState rdf:type owl:Class ;
                      rdfs:subClassOf orda:DigitalServicesCoordinator ;
                      rdfs:comment "The DSC of the member state where the researcher's institution is based. Under Art. 40(9), conducts initial assessment and forwards to the DSC of establishment. Deliberately NOT disjoint with orda:DSCofEstablishment; the same authority can hold both roles."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "DSC of Member State"@en .


###  https://example.org/orda#DataAccessRequest
orda:DataAccessRequest rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:unionOf ( orda:Art40_12_DataAccessRequest
                                                           orda:Art40_4_DataAccessRequest
                                                         )
                                           ] ;
                       rdfs:subClassOf <https://w3id.org/dpv/owl#Process> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty orda:includesResearcher ;
                                         owl:someValuesFrom orda:ApplicantResearcher
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty orda:isPartOf ;
                                         owl:someValuesFrom orda:ResearchProject
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty orda:hasAccessJustification ;
                                         owl:someValuesFrom orda:NecessityStatement
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty orda:hasAccessJustification ;
                                         owl:someValuesFrom orda:ProportionalityStatement
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty orda:accessStartDate ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:date
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty orda:accessEndDate ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:date
                                       ] ;
                       owl:disjointWith orda:ReasonedRequest ,
                                        orda:ResearchProject ,
                                        orda:StatusEvent ;
                       rdfs:comment "A formal request by a researcher to access data from a VLOP or VLOSE under DSA Art. 40. Superclass for the two distinct processes: Art. 40(4) non-public data via DSC, and Art. 40(12) public data direct to platform. Every application must propose the period of access it seeks, via orda:accessStartDate and orda:accessEndDate, and must carry both limbs of the Art. 40(8)(e) demonstration via orda:hasAccessJustification. Both requirements sit on this superclass rather than on the Art. 40(4) sub-class because Art. 40(12) cross-references Art. 40(8) points (b) to (e), so the necessity and proportionality condition, and with it the demonstration of the time frames requested, binds on both routes."@en ;
                       rdfs:isDefinedBy <https://example.org/orda> ;
                       rdfs:label "Data Access Request"@en ;
                       rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_40> .


###  https://example.org/orda#DataHandlingClause
orda:DataHandlingClause rdf:type owl:Class ;
                        rdfs:subClassOf orda:DataHandlingMeasure ;
                        rdfs:comment "A legal clause that governs how data is handled under specific conditions, such as international transfers. Instances include the Transfer Impact Assessment required when data is sent outside the EU/EEA."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Data Handling Clause"@en .


###  https://example.org/orda#DataHandlingMeasure
orda:DataHandlingMeasure rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/dpv/owl#LegalMeasure> ;
                         rdfs:comment "A protective measure, whether technical, legal or organisational, attached to a dcat:Distribution to govern how the data it describes may be accessed and handled."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "Data Handling Measure"@en .


###  https://example.org/orda#DataManagementPlan
orda:DataManagementPlan rdf:type owl:Class ;
                        rdfs:subClassOf orda:DataHandlingMeasure ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://w3id.org/dpv/owl#hasStorageCondition> ;
                                          owl:someValuesFrom <https://w3id.org/dpv/owl#StorageDeletion>
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://w3id.org/dpv/owl#hasStorageCondition> ;
                                          owl:someValuesFrom <https://w3id.org/dpv/owl#StorageDuration>
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://w3id.org/dpv/owl#hasTechnicalOrganisationalMeasure> ;
                                          owl:someValuesFrom <https://w3id.org/dpv/owl#TechnicalOrganisationalMeasure>
                                        ] ;
                        rdfs:comment "A plan governing how accessed data is stored, protected and deleted. Retention, deletion and security requirements are expressed with DPV terms: dpv:StorageDuration and dpv:StorageDeletion via dpv:hasStorageCondition, and dpv:TechnicalOrganisationalMeasure via dpv:hasTechnicalOrganisationalMeasure."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Data Management Plan"@en .


###  https://example.org/orda#DataProvider
orda:DataProvider rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( orda:VeryLargeOnlinePlatform
                                                      orda:VeryLargeOnlineSearchEngine
                                                    )
                                      ] ;
                  rdfs:subClassOf dpv:LegalEntity ;
                  rdfs:comment "A superset including VLOPs and VLOSEs"@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "Data Provider"@en .


###  https://example.org/orda#DigitalServicesCoordinator
orda:DigitalServicesCoordinator rdf:type owl:Class ;
                                rdfs:subClassOf dpv:LegalEntity ;
                                rdfs:comment "A national authority designated under DSA Art. 49 to oversee DSA compliance and handle researcher data access applications under Art. 40."@en ;
                                rdfs:isDefinedBy <https://example.org/orda> ;
                                rdfs:label "Digital Services Coordinator"@en ;
                                rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_49> .


###  https://example.org/orda#EthicalReview
orda:EthicalReview rdf:type owl:Class ;
                   rdfs:comment "Independent ethics committee or IRB review confirming the research design meets ethical standards before data access is granted. Distinct from orda:ExpertConsultation, which is the DSC-initiated consultation under DA Art. 14: an ethical review is commissioned by the research side, not by the assessing authority."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "Ethical Review"@en .


###  https://example.org/orda#ExpertConsultation
orda:ExpertConsultation rdf:type owl:Class ;
                        rdfs:comment "An optional consultation with independent experts or advisory mechanisms during the assessment of an Art. 40(4) application, per DA Art. 14."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Expert Consultation"@en .


###  https://example.org/orda#FavoriteHistory
orda:FavoriteHistory rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:intersectionOf ( orda:ActivityHistory
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty as:items ;
                                                                  owl:someValuesFrom as:Like
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty as:items ;
                                                                  owl:allValuesFrom as:Like
                                                                ]
                                                              )
                                         ] ;
                     rdfs:comment "A history of content favourited. Because this is defined over as:Like alone while orda:ReactionHistory admits as:Like and as:Dislike, every favorite history is inferred to be a reaction history."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Favorite History"@en .


###  https://example.org/orda#FollowHistory
orda:FollowHistory rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:intersectionOf ( orda:ActivityHistory
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty as:items ;
                                                                owl:someValuesFrom as:Follow
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty as:items ;
                                                                owl:allValuesFrom as:Follow
                                                              ]
                                                            )
                                       ] ;
                   rdfs:comment "A history of follow relationships. ActivityStreams models following as a single as:Follow activity, so follower and followed histories cannot be told apart by member type alone; the two directions are given as primitive subclasses."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "Follow History"@en .


###  https://example.org/orda#FollowerHistory
orda:FollowerHistory rdf:type owl:Class ;
                     rdfs:subClassOf orda:FollowHistory ;
                     owl:disjointWith orda:FollowingHistory ;
                     rdfs:comment "A history of the accounts that follow the subject account, that is, as:Follow activities in which the subject is the object rather than the actor. Primitive rather than defined: the direction is a property of the activity's participants, not of its type, so OWL cannot separate it from orda:FollowingHistory by member type. Corresponds to the ActivityPub 'followers' collection, which is not part of the ActivityStreams 2.0 Recommendation."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Follower History"@en .


###  https://example.org/orda#FollowingHistory
orda:FollowingHistory rdf:type owl:Class ;
                      rdfs:subClassOf orda:FollowHistory ;
                      rdfs:comment "A history of the accounts the subject account follows: as:Follow activities in which the subject is the actor. Corresponds to the ActivityPub 'following' collection, which is not part of the ActivityStreams 2.0 Recommendation. See orda:FollowerHistory for why this is primitive."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "Following History"@en .


###  https://example.org/orda#FundamentalRightsRisk
orda:FundamentalRightsRisk rdf:type owl:Class ;
                           rdfs:subClassOf orda:SystemicRisk ;
                           rdfs:comment "DSA Art. 34(1)(b): systemic risks of negative effects on fundamental rights."@en ;
                           rdfs:isDefinedBy <https://example.org/orda> ;
                           rdfs:label "Fundamental Rights Risk"@en .


###  https://example.org/orda#IllegalContentRisk
orda:IllegalContentRisk rdf:type owl:Class ;
                        rdfs:subClassOf orda:SystemicRisk ;
                        rdfs:comment "DSA Art. 34(1)(a): systemic risks from dissemination of illegal content."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Illegal Content Risk"@en .


###  https://example.org/orda#InternationalDataTransferMeasure
orda:InternationalDataTransferMeasure rdf:type owl:Class ;
                                      rdfs:subClassOf orda:DataHandlingMeasure ;
                                      rdfs:comment "Measures to ensure that any transfer of data out of the EU/EEA is subject to an appropriate transfer mechanism under GDPR Chapter V. Instances include Standard Contractual Clauses and Adequacy Decisions."@en ;
                                      rdfs:isDefinedBy <https://example.org/orda> ;
                                      rdfs:label "International Data Transfer Measure"@en ;
                                      rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32016R0679#chap_V> .


###  https://example.org/orda#LegalModality
orda:LegalModality rdf:type owl:Class ;
                   rdfs:subClassOf orda:AccessModality ;
                   rdfs:comment "An access modality whose character is primarily legal, e.g. contractual undertakings, confidentiality agreements, transfer mechanisms."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "Legal Modality"@en .


###  https://example.org/orda#MethodologicalReview
orda:MethodologicalReview rdf:type owl:Class ;
                          rdfs:subClassOf orda:ExpertConsultation ;
                          rdfs:comment "Review of research methodology to ensure data requested is necessary and proportionate to the stated research objectives."@en ;
                          rdfs:isDefinedBy <https://example.org/orda> ;
                          rdfs:label "Methodological Review"@en .


###  https://example.org/orda#NecessityStatement
orda:NecessityStatement rdf:type owl:Class ;
                        rdfs:subClassOf orda:AccessJustification ;
                        rdfs:comment "The limb of the Art. 40(8)(e) demonstration addressing necessity: that the applicant cannot answer the research question without the data and time frames requested. Deliberately not declared disjoint from orda:ProportionalityStatement, because Art. 40(8)(e) states a single conjoint test ('necessary for, and proportionate to'), so one statement may discharge both limbs and be typed as both."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Necessity Statement"@en .


###  https://example.org/orda#OrganisationalModality
orda:OrganisationalModality rdf:type owl:Class ;
                            rdfs:subClassOf orda:AccessModality ;
                            rdfs:comment "An access modality realised through organisational measures, e.g. on-site-only access, mediation by a trusted third party."@en ;
                            rdfs:isDefinedBy <https://example.org/orda> ;
                            rdfs:label "Organisational Modality"@en .


###  https://example.org/orda#PlatformAccount
orda:PlatformAccount rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:unionOf ( as:Application
                                                         as:Group
                                                         as:Organization
                                                         as:Person
                                                         as:Service
                                                       )
                                         ] ;
                     rdfs:comment "An account on a platform, held by a person, organisation, group or automated agent. ActivityStreams has no single class for this: it lists Application, Group, Organization, Person and Service as actor types but defines no common as:Actor superclass, so ORDA supplies the union. Automated or bot accounts are typed as:Application or as:Service. An account is not the human holding it; the two are related by orda:hasAccount, whose domain is dpv:NaturalPerson. ORDA deliberately stops short of declaring the two classes disjoint (see the note on deliberate non-disjointness in the documentation), so the separation is carried by that property rather than enforced by an axiom, and data typing one individual as both an account and a natural person will not be flagged."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Platform Account"@en .


###  https://example.org/orda#PrincipalResearcher
orda:PrincipalResearcher rdf:type owl:Class ;
                         rdfs:subClassOf orda:ApplicantResearcher ;
                         rdfs:comment "The principal researcher who is the primary contact for a data access application and bears responsibility for the request. Per DA Art. 2 and 7."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "Principal Researcher"@en .


###  https://example.org/orda#ProportionalityStatement
orda:ProportionalityStatement rdf:type owl:Class ;
                              rdfs:subClassOf orda:AccessJustification ;
                              rdfs:comment "The limb of the Art. 40(8)(e) demonstration addressing proportionality: that the scope of the data and the time frames requested is no wider than the research purpose warrants. Deliberately not declared disjoint from orda:NecessityStatement; see that term."@en ;
                              rdfs:isDefinedBy <https://example.org/orda> ;
                              rdfs:label "Proportionality Statement"@en .


###  https://example.org/orda#PublicWellbeingRisk
orda:PublicWellbeingRisk rdf:type owl:Class ;
                         rdfs:subClassOf orda:SystemicRisk ;
                         rdfs:comment "DSA Art. 34(1)(d): systemic risks of negative effects on public health, physical and mental wellbeing, or gender-based violence."@en ;
                         rdfs:isDefinedBy <https://example.org/orda> ;
                         rdfs:label "Public Wellbeing Risk"@en .


###  https://example.org/orda#PublishPostHistory
orda:PublishPostHistory rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:intersectionOf ( orda:ActivityHistory
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty as:items ;
                                                                     owl:someValuesFrom as:Create
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty as:items ;
                                                                     owl:allValuesFrom as:Create
                                                                   ]
                                                                 )
                                            ] ;
                        rdfs:comment "A history of content published by the account, defined over as:Create."@en ;
                        rdfs:isDefinedBy <https://example.org/orda> ;
                        rdfs:label "Publish Post History"@en .


###  https://example.org/orda#ReactionHistory
orda:ReactionHistory rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:intersectionOf ( orda:ActivityHistory
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty as:items ;
                                                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                                 owl:unionOf ( as:Dislike
                                                                               as:Like
                                                                             )
                                                               ]
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty as:items ;
                                                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                                 owl:unionOf ( as:Dislike
                                                                               as:Like
                                                                             )
                                                               ]
                                                                ]
                                                              )
                                         ] ;
                     rdfs:comment "A history of reactions to content, whether positive or negative. Subsumes orda:FavoriteHistory."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Reaction History"@en .


###  https://example.org/orda#ReasonedRequest
orda:ReasonedRequest rdf:type owl:Class ;
                     rdfs:comment "A formally reasoned request issued by the DSC of establishment to a VLOP or VLOSE under DSA Art. 40(4), triggering the platform's obligation to provide data. Legally distinct from the researcher's application. Content requirements specified in DA Art. 10. Published in the DSA Data Access Portal per DA Art. 11."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Reasoned Request"@en ;
                     rdfs:seeAlso <http://data.europa.eu/eli/reg_del/2025/2050/oj> .


###  https://example.org/orda#ResearchActivity
orda:ResearchActivity rdf:type owl:Class ;
                      rdfs:comment "The actions taken with the data used. (e.g data analysis, modeling, comparison, etc.)"@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "Research Activity"@en .


###  https://example.org/orda#ResearchMethod
orda:ResearchMethod rdf:type owl:Class ;
                    rdfs:isDefinedBy <https://example.org/orda> ;
                    rdfs:label "Research Method"@en .


###  https://example.org/orda#ResearchProject
orda:ResearchProject rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/dpv/owl#Process> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty frapo:isFundedBy ;
                                       owl:someValuesFrom frapo:Funding
                                     ] ;
                     rdfs:comment "A research project that processes data, defined as a subclass of dpv:Process. Under DSA Art. 40, may submit data access requests to investigate systemic risks or assess risk mitigation measures within the EU."@en ;
                     rdfs:isDefinedBy <https://example.org/orda> ;
                     rdfs:label "Research Project"@en .


###  https://example.org/orda#ResearchQuestion
orda:ResearchQuestion rdf:type owl:Class ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "Research Question"@en .


###  https://example.org/orda#ResearchTopic
orda:ResearchTopic rdf:type owl:Class ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "Research Topic"@en .


###  https://example.org/orda#Researcher
orda:Researcher rdf:type owl:Class ;
                rdfs:subClassOf foaf:Person ;
                rdfs:comment "A researcher who may participate in the DSA Art. 40 data access process. Broader class encompassing all researcher roles."@en ;
                rdfs:isDefinedBy <https://example.org/orda> ;
                rdfs:label "Researcher"@en .


###  https://example.org/orda#RiskMitigationMeasure
orda:RiskMitigationMeasure rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/dpv/owl#RiskMitigationMeasure> ;
                           rdfs:comment "A measure put in place by a VLOP or VLOSE under DSA Art. 35 to mitigate the systemic risks identified under Art. 34. Specialises dpv:RiskMitigationMeasure to the DSA systemic-risk setting, mirroring the way orda:SystemicRisk is kept distinct from dpv:Risk."@en ;
                           rdfs:isDefinedBy <https://example.org/orda> ;
                           rdfs:label "Risk Mitigation Measure"@en ;
                           rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_35> .


###  https://example.org/orda#Search
orda:Search rdf:type owl:Class ;
            rdfs:subClassOf as:Activity ;
            rdfs:comment "A query issued by an account against a platform's search function. ORDA-native: ActivityStreams defines no search activity, because searching is not a social action published to a stream. The term is required nonetheless: search and query logs are among the data categories most often sought under Article 40, particularly from very large online search engines."@en ;
            rdfs:isDefinedBy <https://example.org/orda> ;
            rdfs:label "Search"@en .


###  https://example.org/orda#SearchHistory
orda:SearchHistory rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:intersectionOf ( orda:ActivityHistory
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty as:items ;
                                                                owl:someValuesFrom orda:Search
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty as:items ;
                                                                owl:allValuesFrom orda:Search
                                                              ]
                                                            )
                                       ] ;
                   rdfs:comment "A history of queries issued by the account. Defined over the ORDA-native orda:Search, as ActivityStreams supplies no equivalent activity type."@en ;
                   rdfs:isDefinedBy <https://example.org/orda> ;
                   rdfs:label "Search History"@en .


###  https://example.org/orda#ShareHistory
orda:ShareHistory rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:intersectionOf ( orda:ActivityHistory
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty as:items ;
                                                               owl:someValuesFrom as:Announce
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty as:items ;
                                                               owl:allValuesFrom as:Announce
                                                             ]
                                                           )
                                      ] ;
                  rdfs:comment "A history of content shared or reposted by the account, defined over as:Announce."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "Share History"@en .


###  https://example.org/orda#StatusEvent
orda:StatusEvent rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty orda:eventStatus ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass skos:Concept
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty orda:eventDate ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:date
                                 ] ;
                 rdfs:comment "A timestamped event recording a status change in the lifecycle of a data access request. Captures who triggered the change, when, and what the new status is."@en ;
                 rdfs:isDefinedBy <https://example.org/orda> ;
                 rdfs:label "Status Event"@en .


###  https://example.org/orda#SystemicRisk
orda:SystemicRisk rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( orda:CivicDiscourseRisk
                                                      orda:FundamentalRightsRisk
                                                      orda:IllegalContentRisk
                                                      orda:PublicWellbeingRisk
                                                    )
                                      ] ;
                  rdfs:comment "A societal risk as defined under DSA Art. 34, stemming from the design or functioning of a VLOP or VLOSE within the EU. Distinct from dpv:Risk which covers data processing risks."@en ;
                  rdfs:isDefinedBy <https://example.org/orda> ;
                  rdfs:label "Systemic Risk"@en ;
                  rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_34> .


###  https://example.org/orda#TechnicalModality
orda:TechnicalModality rdf:type owl:Class ;
                       rdfs:subClassOf orda:AccessModality ;
                       rdfs:comment "An access modality realised through technical controls, e.g. secure enclaves, restricted APIs, pseudonymisation, query-only access."@en ;
                       rdfs:isDefinedBy <https://example.org/orda> ;
                       rdfs:label "Technical Modality"@en .


###  https://example.org/orda#VeryLargeOnlinePlatform
orda:VeryLargeOnlinePlatform rdf:type owl:Class ;
                             rdfs:subClassOf orda:DataProvider ;
                             owl:disjointWith orda:VeryLargeOnlineSearchEngine ;
                             rdfs:comment "A platform designated as a VLOP under DSA Art. 33, with over 45 million monthly active users in the EU."@en ;
                             rdfs:isDefinedBy <https://example.org/orda> ;
                             rdfs:label "Very Large Online Platform"@en ;
                             rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_33> .


###  https://example.org/orda#VeryLargeOnlineSearchEngine
orda:VeryLargeOnlineSearchEngine rdf:type owl:Class ;
                                 rdfs:subClassOf orda:DataProvider ;
                                 rdfs:comment "A search engine designated as a VLOSE under DSA Art. 33."@en ;
                                 rdfs:isDefinedBy <https://example.org/orda> ;
                                 rdfs:label "Very Large Online Search Engine"@en ;
                                 rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065#art_33> .


###  https://example.org/orda#VettedResearcher
orda:VettedResearcher rdf:type owl:Class ;
                      rdfs:subClassOf orda:Researcher ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty orda:affiliatedWith ;
                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                             owl:unionOf ( frapo:College
                                                                           frapo:ResearchInstitute
                                                                           frapo:University
                                                                         )
                                                           ]
                                      ] ;
                      rdfs:comment "A researcher vetted under DSA Art. 40(8) by a DSC to access non-public platform data under Art. 40(4). Must be affiliated with a research organisation per Dir. 2019/790 Art. 2(1). Not required to be based in the EU; the systemic risk being researched must occur within the EU."@en ;
                      rdfs:isDefinedBy <https://example.org/orda> ;
                      rdfs:label "Vetted Researcher"@en .


###  https://w3id.org/dpv#Adult
dpv:Adult rdf:type owl:Class ;
          rdfs:subClassOf dpv:DataSubject ;
          rdfs:comment "A natural person that is not a child i.e. has attained the age of maturity."@en ;
          rdfs:isDefinedBy <https://w3id.org/dpv> ;
          rdfs:label "Adult"@en .


###  https://w3id.org/dpv#Applicant
dpv:Applicant rdf:type owl:Class ;
              rdfs:subClassOf dpv:DataSubject ;
              rdfs:comment "Data subjects that have applied for something."@en ;
              rdfs:isDefinedBy <https://w3id.org/dpv> ;
              rdfs:label "Applicant"@en .


###  https://w3id.org/dpv#AsylumSeeker
dpv:AsylumSeeker rdf:type owl:Class ;
                 rdfs:subClassOf dpv:VulnerableDataSubject ;
                 rdfs:comment "Data subjects that are asylum seekers."@en ;
                 rdfs:isDefinedBy <https://w3id.org/dpv> ;
                 rdfs:label "Asylum Seeker"@en .


###  https://w3id.org/dpv#Child
dpv:Child rdf:type owl:Class ;
          rdfs:subClassOf dpv:DataSubject ;
          rdfs:comment "A natural person that has not attained the age of maturity."@en ;
          rdfs:isDefinedBy <https://w3id.org/dpv> ;
          rdfs:label "Child"@en .


###  https://w3id.org/dpv#Citizen
dpv:Citizen rdf:type owl:Class ;
            rdfs:subClassOf dpv:DataSubject ;
            rdfs:comment "Data subjects that are citizens of a jurisdiction."@en ;
            rdfs:isDefinedBy <https://w3id.org/dpv> ;
            rdfs:label "Citizen"@en .


###  https://w3id.org/dpv#Client
dpv:Client rdf:type owl:Class ;
           rdfs:subClassOf dpv:DataSubject ;
           rdfs:comment "Data subjects that are clients of a service."@en ;
           rdfs:isDefinedBy <https://w3id.org/dpv> ;
           rdfs:label "Client"@en .


###  https://w3id.org/dpv#Consumer
dpv:Consumer rdf:type owl:Class ;
             rdfs:subClassOf dpv:DataSubject ;
             rdfs:comment "Data subjects that consume goods or services."@en ;
             rdfs:isDefinedBy <https://w3id.org/dpv> ;
             rdfs:label "Consumer"@en .


###  https://w3id.org/dpv#Customer
dpv:Customer rdf:type owl:Class ;
             rdfs:subClassOf dpv:DataSubject ;
             rdfs:comment "Data subjects that are customers of a service or product."@en ;
             rdfs:isDefinedBy <https://w3id.org/dpv> ;
             rdfs:label "Customer"@en .


###  https://w3id.org/dpv#DataSubject
dpv:DataSubject rdf:type owl:Class ;
                rdfs:subClassOf dpv:HumanSubject ;
                rdfs:comment "A natural person whose personal data is processed. In the Art. 40 context, these are platform users whose data researchers access. Being a dpv:NaturalPerson, an instance may be linked via orda:hasAccount to the platform accounts it holds; the account itself is an orda:PlatformAccount. The two are distinct (an account is not the person holding it), but ORDA does not assert disjointness between them, so keeping them apart is a modelling convention here rather than something a reasoner enforces. The DPV entity hierarchy and the ActivityStreams actor types are kept independent."@en ;
                rdfs:isDefinedBy <https://w3id.org/dpv> ;
                rdfs:label "Data Subject"@en .


###  https://w3id.org/dpv#ElderlyDataSubject
dpv:ElderlyDataSubject rdf:type owl:Class ;
                       rdfs:subClassOf dpv:VulnerableDataSubject ;
                       rdfs:comment "Data subjects that are considered elderly (i.e. based on age)."@en ;
                       rdfs:isDefinedBy <https://w3id.org/dpv> ;
                       rdfs:label "Elderly Data Subject"@en .


###  https://w3id.org/dpv#Employee
dpv:Employee rdf:type owl:Class ;
             rdfs:subClassOf dpv:DataSubject ;
             rdfs:comment "Data subjects that are employees."@en ;
             rdfs:isDefinedBy <https://w3id.org/dpv> ;
             rdfs:label "Employee"@en .


###  https://w3id.org/dpv#GuardianOfDataSubject
dpv:GuardianOfDataSubject rdf:type owl:Class ;
                          rdfs:subClassOf dpv:DataSubject ;
                          rdfs:comment "Guardian(s) of a data subject."@en ;
                          rdfs:isDefinedBy <https://w3id.org/dpv> ;
                          rdfs:label "Guardian(s) of Data Subject"@en .


###  https://w3id.org/dpv#HumanSubject
dpv:HumanSubject rdf:type owl:Class ;
                 rdfs:subClassOf dpv:NaturalPerson ;
                 rdfs:comment "A human that is the subject of a specific context, such as Data Subject for data or AI Subject for AI."@en ;
                 rdfs:isDefinedBy <https://w3id.org/dpv> ;
                 rdfs:label "Human Subject"@en .


###  https://w3id.org/dpv#Immigrant
dpv:Immigrant rdf:type owl:Class ;
              rdfs:subClassOf dpv:DataSubject ;
              rdfs:comment "Data subjects that are immigrants."@en ;
              rdfs:isDefinedBy <https://w3id.org/dpv> ;
              rdfs:label "Immigrant"@en .


###  https://w3id.org/dpv#JobApplicant
dpv:JobApplicant rdf:type owl:Class ;
                 rdfs:subClassOf dpv:DataSubject ;
                 rdfs:comment "Data subjects that have applied for a job."@en ;
                 rdfs:isDefinedBy <https://w3id.org/dpv> ;
                 rdfs:label "Job Applicant"@en .


###  https://w3id.org/dpv#Justification
dpv:Justification rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/dpv/owl#Context> ;
                  rdfs:comment "A form of documentation providing reasons, explanations, or justifications. ORDA places orda:AccessJustification beneath this so that the Art. 40(8)(e) demonstration is discoverable as a DPV justification, without asserting anything about the DPV term itself."@en ;
                  rdfs:isDefinedBy <https://w3id.org/dpv> ;
                  rdfs:label "Justification"@en .


###  https://w3id.org/dpv#LegalEntity
dpv:LegalEntity rdf:type owl:Class ;
                rdfs:isDefinedBy <https://w3id.org/dpv> .


###  https://w3id.org/dpv#Location
dpv:Location rdf:type owl:Class ;
             rdfs:isDefinedBy <https://w3id.org/dpv> .


###  https://w3id.org/dpv#Member
dpv:Member rdf:type owl:Class ;
           rdfs:subClassOf dpv:DataSubject ;
           rdfs:comment "Data subjects that are members of a group or organisation."@en ;
           rdfs:isDefinedBy <https://w3id.org/dpv> ;
           rdfs:label "Member"@en .


###  https://w3id.org/dpv#MentallyVulnerableDataSubject
dpv:MentallyVulnerableDataSubject rdf:type owl:Class ;
                                  rdfs:subClassOf dpv:VulnerableDataSubject ;
                                  rdfs:comment "Data subjects that are considered mentally vulnerable."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/dpv> ;
                                  rdfs:label "Mentally Vulnerable Data Subject"@en .


###  https://w3id.org/dpv#NaturalPerson
dpv:NaturalPerson rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/dpv/owl#Entity> ;
                  rdfs:comment "A human."@en ;
                  rdfs:isDefinedBy <https://w3id.org/dpv> ;
                  rdfs:label "Natural Person"@en .


###  https://w3id.org/dpv#NonCitizen
dpv:NonCitizen rdf:type owl:Class ;
               rdfs:subClassOf dpv:DataSubject ;
               rdfs:comment "Data subjects that are not citizens of a jurisdiction."@en ;
               rdfs:isDefinedBy <https://w3id.org/dpv> ;
               rdfs:label "Non-Citizen"@en .


###  https://w3id.org/dpv#ParentOfDataSubject
dpv:ParentOfDataSubject rdf:type owl:Class ;
                        rdfs:subClassOf dpv:DataSubject ;
                        rdfs:comment "Parent(s) of a data subject."@en ;
                        rdfs:isDefinedBy <https://w3id.org/dpv> ;
                        rdfs:label "Parent(s) of Data Subject"@en .


###  https://w3id.org/dpv#Participant
dpv:Participant rdf:type owl:Class ;
                rdfs:subClassOf dpv:DataSubject ;
                rdfs:comment "Data subjects that participate in an activity or process."@en ;
                rdfs:isDefinedBy <https://w3id.org/dpv> ;
                rdfs:label "Participant"@en .


###  https://w3id.org/dpv#Patient
dpv:Patient rdf:type owl:Class ;
            rdfs:subClassOf dpv:DataSubject ;
            rdfs:comment "Data subjects that receive medical attention, treatment, or care."@en ;
            rdfs:isDefinedBy <https://w3id.org/dpv> ;
            rdfs:label "Patient"@en .


###  https://w3id.org/dpv#Student
dpv:Student rdf:type owl:Class ;
            rdfs:subClassOf dpv:DataSubject ;
            rdfs:comment "Data subjects that are students."@en ;
            rdfs:isDefinedBy <https://w3id.org/dpv> ;
            rdfs:label "Student"@en .


###  https://w3id.org/dpv#Subscriber
dpv:Subscriber rdf:type owl:Class ;
               rdfs:subClassOf dpv:DataSubject ;
               rdfs:comment "Data subjects that subscribe to a service."@en ;
               rdfs:isDefinedBy <https://w3id.org/dpv> ;
               rdfs:label "Subscriber"@en .


###  https://w3id.org/dpv#SupraNationalUnion
dpv:SupraNationalUnion rdf:type owl:Class ;
                       rdfs:isDefinedBy <https://w3id.org/dpv> .


###  https://w3id.org/dpv#Tourist
dpv:Tourist rdf:type owl:Class ;
            rdfs:subClassOf dpv:DataSubject ;
            rdfs:comment "Data subjects that are tourists."@en ;
            rdfs:isDefinedBy <https://w3id.org/dpv> ;
            rdfs:label "Tourist"@en .


###  https://w3id.org/dpv#User
dpv:User rdf:type owl:Class ;
         rdfs:subClassOf dpv:DataSubject ;
         rdfs:comment "Data subjects that use a service or product."@en ;
         rdfs:isDefinedBy <https://w3id.org/dpv> ;
         rdfs:label "User"@en .


###  https://w3id.org/dpv#Visitor
dpv:Visitor rdf:type owl:Class ;
            rdfs:subClassOf dpv:DataSubject ;
            rdfs:comment "Data subjects that visit a place or service."@en ;
            rdfs:isDefinedBy <https://w3id.org/dpv> ;
            rdfs:label "Visitor"@en .


###  https://w3id.org/dpv#VulnerableDataSubject
dpv:VulnerableDataSubject rdf:type owl:Class ;
                          rdfs:subClassOf dpv:DataSubject ;
                          rdfs:comment "Data subjects which should be considered 'vulnerable' and therefore would require additional measures and safeguards."@en ;
                          rdfs:isDefinedBy <https://w3id.org/dpv> ;
                          rdfs:label "Vulnerable Data Subject"@en .


###  https://www.w3.org/ns/activitystreams#Activity
as:Activity rdf:type owl:Class ;
            rdfs:subClassOf as:Object ;
            rdfs:comment "An action taken by a platform account. The unit from which activity histories are composed."@en ;
            rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
            rdfs:label "Activity"@en .


###  https://www.w3.org/ns/activitystreams#Announce
as:Announce rdf:type owl:Class ;
            rdfs:subClassOf as:Activity ;
            rdfs:comment "The account shared or reposted the object. The ActivityStreams counterpart of a share or boost."@en ;
            rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
            rdfs:label "Announce"@en .


###  https://www.w3.org/ns/activitystreams#Application
as:Application rdf:type owl:Class ;
               rdfs:subClassOf as:Object ;
               rdfs:comment "A software application holding a platform account. Together with as:Service this covers automated or bot accounts, which have no dedicated ActivityStreams type."@en ;
               rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
               rdfs:label "Application"@en .


###  https://www.w3.org/ns/activitystreams#Block
as:Block rdf:type owl:Class ;
         rdfs:subClassOf as:Ignore ;
         rdfs:comment "The account blocked the object. Note that ActivityStreams places Block under as:Ignore rather than directly under as:Activity."@en ;
         rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
         rdfs:label "Block"@en .


###  https://www.w3.org/ns/activitystreams#Collection
as:Collection rdf:type owl:Class ;
              rdfs:subClassOf as:Object ;
              rdfs:comment "A set of objects, linked by as:items. The container from which the orda:ActivityHistory classes are built."@en ;
              rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
              rdfs:label "Collection"@en .


###  https://www.w3.org/ns/activitystreams#Create
as:Create rdf:type owl:Class ;
          rdfs:subClassOf as:Activity ;
          rdfs:comment "The account created the object: the activity underlying a published post."@en ;
          rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
          rdfs:label "Create"@en .


###  https://www.w3.org/ns/activitystreams#Dislike
as:Dislike rdf:type owl:Class ;
           rdfs:subClassOf as:Activity ;
           rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
           rdfs:label "Dislike"@en .


###  https://www.w3.org/ns/activitystreams#Follow
as:Follow rdf:type owl:Class ;
          rdfs:subClassOf as:Activity ;
          rdfs:comment "The account began following the object. ORDA distinguishes follower from following histories by the direction of this activity relative to the account whose history it is, not by two separate activity types."@en ;
          rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
          rdfs:label "Follow"@en .


###  https://www.w3.org/ns/activitystreams#Group
as:Group rdf:type owl:Class ;
         rdfs:subClassOf as:Object ;
         rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
         rdfs:label "Group"@en .


###  https://www.w3.org/ns/activitystreams#Ignore
as:Ignore rdf:type owl:Class ;
          rdfs:subClassOf as:Activity ;
          rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
          rdfs:label "Ignore"@en .


###  https://www.w3.org/ns/activitystreams#Like
as:Like rdf:type owl:Class ;
        rdfs:subClassOf as:Activity ;
        rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
        rdfs:label "Like"@en .


###  https://www.w3.org/ns/activitystreams#Listen
as:Listen rdf:type owl:Class ;
          rdfs:subClassOf as:Activity ;
          rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
          rdfs:label "Listen"@en .


###  https://www.w3.org/ns/activitystreams#Object
as:Object rdf:type owl:Class ;
          rdfs:comment "The root of the ActivityStreams type hierarchy."@en ;
          rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
          rdfs:label "Object"@en .


###  https://www.w3.org/ns/activitystreams#OrderedCollection
as:OrderedCollection rdf:type owl:Class ;
                     rdfs:subClassOf as:Collection ;
                     rdfs:comment "A collection whose members carry a defined order. ActivityStreams expresses the ordering in JSON-LD serialisation rather than through a distinct RDF property, so members are still reached via as:items."@en ;
                     rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
                     rdfs:label "Ordered Collection"@en .


###  https://www.w3.org/ns/activitystreams#Organization
as:Organization rdf:type owl:Class ;
                rdfs:subClassOf as:Object ;
                rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
                rdfs:label "Organization"@en .


###  https://www.w3.org/ns/activitystreams#Person
as:Person rdf:type owl:Class ;
          rdfs:subClassOf as:Object ;
          rdfs:comment "An account held by a natural person. Distinct from dpv:NaturalPerson: as:Person is the account, not the human behind it, and one human may hold several. The two are related by orda:hasAccount; ORDA does not assert disjointness between them."@en ;
          rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
          rdfs:label "Person"@en .


###  https://www.w3.org/ns/activitystreams#Read
as:Read rdf:type owl:Class ;
        rdfs:subClassOf as:Activity ;
        rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
        rdfs:label "Read"@en .


###  https://www.w3.org/ns/activitystreams#Service
as:Service rdf:type owl:Class ;
           rdfs:subClassOf as:Object ;
           rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
           rdfs:label "Service"@en .


###  https://www.w3.org/ns/activitystreams#View
as:View rdf:type owl:Class ;
        rdfs:subClassOf as:Activity ;
        rdfs:comment "The account viewed the object. With as:Read and as:Listen this covers content consumption: the closest ActivityStreams comes to a recommender impression log."@en ;
        rdfs:isDefinedBy <https://www.w3.org/ns/activitystreams> ;
        rdfs:label "View"@en .


