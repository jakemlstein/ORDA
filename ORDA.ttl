#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( orda:CivicDiscourseRisk
                orda:FundamentalRightsRisk
                orda:IllegalContentRisk
                orda:PublicWellbeingRisk
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( orda:DataProvider
                orda:DigitalServicesCoordinator
                orda:Researcher
              )
] .


